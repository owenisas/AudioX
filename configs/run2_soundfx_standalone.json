{
  "pretrained_name": "HKUSTAudio/AudioX-MAF-MMDiT",
  "output_dir": "./outputs/run2_soundfx_standalone",
  "data": {
    "train_manifest": "./data/soundfx_train.jsonl",
    "val_manifest": "./data/soundfx_val.jsonl",
    "batch_size": 2,
    "eval_batch_size": 1,
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "drop_last": false,
    "random_crop": false,
    "seed": 42,
    "prompt_format": "natural",
    "include_video_conditioning": false,
    "include_audio_conditioning": false,
    "compute_video_sync_on_the_fly": false,
    "sample_strategy": "uniform",
    "sample_text_prompt_candidates": true,
    "sample_text_prompt_candidates_for_eval": false,
    "video_duration_seconds": 10.0
  },
  "training": {
    "text_max_length": 256,
    "learning_rate": 1e-05,
    "lora_learning_rate": 1e-04,
    "use_ema": true,
    "mask_padding": true,
    "cfg_dropout_prob": 0.1,
    "timestep_sampler": "uniform",
    "log_loss_info": false,
    "trainable_scope": "asmr_continuation_lora"
  },
  "trainer": {
    "accelerator": "gpu",
    "devices": 1,
    "precision": "bf16-mixed",
    "max_epochs": 1,
    "max_steps": 8000,
    "accumulate_grad_batches": 4,
    "gradient_clip_val": 1.0,
    "log_every_n_steps": 10,
    "num_sanity_val_steps": 0,
    "val_check_interval": 500
  },
  "checkpointing": {
    "dirpath": "./outputs/run2_soundfx_standalone/checkpoints",
    "filename": "step={step}",
    "enabled": true,
    "save_last": true,
    "monitor": "val/loss",
    "mode": "min",
    "save_top_k": 3,
    "every_n_train_steps": 500,
    "save_final_checkpoint": true,
    "save_lora_only": true,
    "final_checkpoint_name": "final-lora-state.pt"
  },
  "lora": {
    "enabled": true,
    "rank": 16,
    "alpha": 32.0,
    "dropout": 0.05,
    "freeze_non_lora": true,
    "target_patterns": [
      "to_q",
      "to_kv",
      "to_qkv",
      "to_out",
      ".qkv",
      "ffn"
    ]
  },
  "wandb": {
    "enabled": true,
    "project": "audiox-finetune",
    "name": "run2-soundfx-standalone",
    "offline": false,
    "log_model": false
  }
}
