{
  "pretrained_name": "HKUSTAudio/AudioX-MAF-MMDiT",
  "output_dir": "./outputs/audiox_mixed_preference_stable3_5090",
  "data": {
    "train_manifest": "./data/mixed_preference_train.jsonl",
    "val_manifest": "./data/mixed_preference_val.jsonl",
    "batch_size": 1,
    "eval_batch_size": 1,
    "num_workers": 2,
    "pin_memory": true,
    "persistent_workers": false,
    "drop_last": false,
    "random_crop": false,
    "seed": 0,
    "prompt_format": "natural",
    "include_video_conditioning": true,
    "include_audio_conditioning": true,
    "compute_video_sync_on_the_fly": false,
    "sample_strategy": "weighted",
    "standalone_ratio": 0.3,
    "continuation_ratio": 0.7,
    "sample_text_prompt_candidates": true,
    "sample_text_prompt_candidates_for_eval": false
  },
  "evaluation": {
    "test_manifest": "./data/mixed_preference_test.jsonl"
  },
  "training": {
    "text_max_length": 256,
    "learning_rate": 1e-06,
    "use_ema": false,
    "mask_padding": true,
    "cfg_dropout_prob": 0.1,
    "timestep_sampler": "uniform",
    "log_loss_info": false,
    "trainable_scope": "maf_continuation_lora"
  },
  "trainer": {
    "accelerator": "cuda",
    "devices": 1,
    "precision": "bf16-mixed",
    "max_epochs": 1,
    "max_steps": 3000,
    "accumulate_grad_batches": 1,
    "gradient_clip_val": 0.1,
    "log_every_n_steps": 10,
    "num_sanity_val_steps": 0
  },
  "checkpointing": {
    "dirpath": "./outputs/audiox_mixed_preference_stable3_5090/checkpoints",
    "filename": "step={step}",
    "enabled": false,
    "save_last": false,
    "save_top_k": 0,
    "every_n_train_steps": 0,
    "save_final_checkpoint": true,
    "save_lora_only": true,
    "final_checkpoint_name": "final-lora-state.pt"
  },
  "lora": {
    "enabled": true,
    "rank": 16,
    "alpha": 32.0,
    "dropout": 0.05,
    "freeze_non_lora": true,
    "target_patterns": [
      "attn.qkv",
      "cross_attn.to_q",
      "cross_attn.to_kv",
      "ffn"
    ]
  },
  "wandb": {
    "enabled": true,
    "project": "audiox-finetune",
    "name": "audiox-mixed-pref-full-stable3-5090",
    "offline": false,
    "log_model": false
  },
  "huggingface": {
    "enabled": false
  },
  "resume_from_checkpoint": "./checkpoints/last-v2.ckpt"
}
