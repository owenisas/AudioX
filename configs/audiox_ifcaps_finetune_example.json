{
  "seed": 42,
  "output_dir": "finetune_runs/audiox-xml",
  "model": {
    "pretrained_name": "HKUSTAudio/AudioX-MAF",
    "text_max_length": 256
  },
  "data": {
    "train_manifest": "path/to/train_manifest.jsonl",
    "val_manifest": "path/to/val_manifest.jsonl",
    "batch_size": 1,
    "num_workers": 0,
    "shuffle": true,
    "drop_last": true,
    "pin_memory": false,
    "random_crop": true,
    "prompt_format": "mixed",
    "xml_compact": true,
    "xml_include_caption": true,
    "xml_max_events": 8,
    "prompt_seed": 0
  },
  "training": {
    "learning_rate": 1e-5,
    "use_ema": true,
    "mask_padding": true,
    "mask_padding_dropout": 0.0,
    "cfg_dropout_prob": 0.1,
    "timestep_sampler": "uniform"
  },
  "trainer": {
    "accelerator": "auto",
    "devices": 1,
    "precision": "16-mixed",
    "max_steps": 1000,
    "accumulate_grad_batches": 1,
    "gradient_clip_val": 0.0,
    "log_every_n_steps": 10,
    "val_check_interval": 250,
    "limit_val_batches": 10,
    "checkpoint_every_n_train_steps": 500,
    "save_top_k": 3,
    "monitor": "train/loss",
    "monitor_mode": "min",
    "num_sanity_val_steps": 0
  }
}
